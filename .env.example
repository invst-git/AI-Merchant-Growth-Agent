# Copy this file to .env and fill in your own credentials.
# Never commit .env, it is already in .gitignore.

# Razorpay Test Mode: Dashboard > Account & Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Used starting Phase 4 (webhook signature verification), leave blank for now
RAZORPAY_WEBHOOK_SECRET=

# Kaggle API: kaggle.com/settings > API > Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Phase 3 agents: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx
# Optional, defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5
